# The MiDojo Claude Code plugin, as an overlay on *any* Claude Code agent image.
#
# This is the only MiDojo-specific build step: take the customer's agent image,
# add the plugin hook, the SDK it talks to the control plane with, and the
# settings that load the hook headlessly. Point AGENT_IMAGE at the customer's
# image; it defaults to the demo agent (Containerfile.agent).
#
# Build (from repo root), after the agent image exists:
#   podman build --build-arg AGENT_IMAGE=localhost/claude-code-agent:latest \
#     -t localhost/claude-code-demo:latest -f suites/claude_code_demo/sandbox/Containerfile .
#
# Assumes the agent image has a Python with a venv at /sandbox/.venv (the
# OpenShell base provides one) and reads user settings from /sandbox/.claude.
# For a different base, adjust the python path in settings.json and this COPY.

ARG AGENT_IMAGE=localhost/claude-code-agent:latest
FROM ${AGENT_IMAGE}

USER root
RUN mkdir -p /sandbox/midojo /sandbox/.claude
COPY interception/claude-code/midojo_hook.py /sandbox/midojo/
COPY interception/python-sdk/ /tmp/midojo-sdk/
RUN uv pip install --no-cache --python /sandbox/.venv/bin/python3 /tmp/midojo-sdk && rm -rf /tmp/midojo-sdk
COPY suites/claude_code_demo/sandbox/settings.json /sandbox/.claude/settings.json
RUN chown -R sandbox:sandbox /sandbox/midojo /sandbox/.claude
USER sandbox
